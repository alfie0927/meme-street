[Unit]
Description=Meme Street: make the Daily Chart recap reel
After=network-online.target
[Service]
Type=oneshot
User=__USER__
ExecStart=__DIR__/make_reel.sh
TimeoutStartSec=3600
# the game runs on this server too: rendering gets one core, low priority, and is stopped before it can starve it
Nice=19
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=2G
