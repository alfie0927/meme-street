": "outro", "text": "Save this cheat sheet", "vo": "Save this, then practise naming them at memestreet.net.", "chart": null}], "caption": "Three chart shapes in thirty seconds. Name them before I do.\n\n1. A range: highs and lows at about the same prices.\n2. A double top: it only counts when a close breaks the trigger.\n3. A bearish engulfing candle: a red body covering the green one before it.\n\nSave this for your next chart.\nPractise at memestreet.net\n\nFictional market. Not investment advice.\n\n#MemeStreet #ChartPatterns #Candlesticks #LearnToTrade", "charts": [{"candles": [[56.47, 58.1, 53.44, 57.62, 93615], [57.61, 59.07, 57.41, 58.98, 31954], [58.95, 60.02, 56.21, 58.57, 67586], [58.52, 64.82, 57.38, 64.7, 138831], [64.79, 69.85, 64.62, 69.77, 101526], [69.77, 69.8, 64.38, 67.84, 108461], [67.84, 68.31, 65.09, 65.96, 122219], [65.97, 67.53, 65.9, 67.53, 52383], [67.42, 67.51, 66.57, 66.82, 16979], [66.81, 67.16, 66.04, 66.59, 20472], [66.62, 70.25, 66.62, 69.46, 15298], [69.46, 70.65, 69.28, 70.32, 24137], [70.35, 82.13, 70.28, 82.12, 30893], [82.13, 85.5, 81.44, 81.56, 26867], [81.5, 81.7, 78.94, 79.28, 45177], [79.23, 81.61, 79.15, 81.53, 47536], [81.51, 85.55, 81.51, 85.54, 12956], [85.54, 87.13, 85.5, 86.73, 13435], [86.7, 87.56, 86.33, 86.73, 22603], [86.73, 88.88, 86.54, 88.26, 48274], [88.35, 89.94, 87.66, 89.47, 42354], [89.48, 90.85, 88.29, 90.51, 55530], [90.69, 93.37, 90.67, 93.22, 32299], [93.23, 93.89, 90.86, 92.46, 41188], [92.48, 93.0, 92.17, 92.39, 14602], [92.39, 94.39, 92.39, 94.0, 16650], [93.93, 96.96, 92.55, 96.89, 23848], [96.91, 97.2, 92.65, 92.88, 14624], [92.9, 94.62, 92.1, 92.89, 36428], [92.89, 93.18, 85.48, 88.14, 42883], [88.11, 88.75, 84.41, 85.64, 17859], [85.63, 88.45, 84.91, 88.45, 23552], [88.42, 91.33, 88.33, 90.81, 17678], [90.8, 91.92, 90.78, 91.92, 7478], [91.9, 92.07, 91.05, 91.06, 7121], [91.07, 91.08, 87.99, 89.51, 28600], [89.58, 91.86, 89.07, 91.58, 18491], [91.58, 92.35, 91.18, 92.27, 13114], [92.27, 92.97, 92.2