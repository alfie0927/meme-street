# Copy to config.env and fill in. Keep it private (setup.sh sets chmod 600). Never commit config.env.

# --- Meme Street account the bot plays the Daily Chart with (it never trades) ---
MS_USER=ms_daily_recap
MS_PASS=change-me

# --- Instagram connection (README section 4) ---
# instagram = Instagram Login (recommended: no Facebook Page, needs the two PUBLIC_VIDEO_* lines)
# facebook  = Facebook Login (needs a linked Facebook Page; uploads directly, no hosting needed)
IG_LOGIN=instagram
IG_ACCESS_TOKEN=
# IG_USER_ID=          (optional; looked up automatically)
GRAPH_VERSION=v24.0

# Where the bot puts tonight's video so Instagram can fetch it (instagram mode).
# The folder must be served publicly by your website at the URL below (README section 3).
PUBLIC_VIDEO_DIR=/var/www/memestreet-reels
PUBLIC_VIDEO_URL=https://memestreet.net/reels

# Rendering: 60 = smoothest, 30 = twice as fast to render
FPS=60
