# Caddy is the web server in front of the game. It gets the https certificate for your domain by itself (and renews it),
# redirects www to the bare domain, and passes everything to the gateways on port 8000. Websockets just work.
# setup_server.sh replaces YOURDOMAIN with the domain you give it.

{
	servers {
		# Cloudflare (ROADMAP O4). With the site behind Cloudflare, every request arrives from one of Cloudflare's addresses
		# (https://www.cloudflare.com/ips) and the visitor's own address is in the CF-Connecting-IP header. Caddy believes
		# that header only when the request comes from these addresses, so {client_ip} below is the visitor's address
		# with or without Cloudflare, and nobody can fake it by sending the header straight to the server.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

YOURDOMAIN {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# No page may be shown inside another site's frame, except the Daily at /embed/daily (REACH_PLAN P2), and that one
	# only by the hosts named here. To let another site frame it (a school, a blog), add its https:// address to the list.
	@noframe not path /embed/daily
	header @noframe X-Frame-Options "DENY"
	@embed path /embed/daily
	header @embed Content-Security-Policy "frame-ancestors 'self' https://itch.io https://*.itch.io https://*.itch.zone"

	# The visit log (growth plan 2026-11-10): which links and pages bring people, read by tools/visits.py, kept 30 days.
	# No login token reaches it: the token travels in the X-Token header and in the WebSocket address (/ws?token=...),
	# and both are taken out below, with the visitor id, the admin key, cookies and order and payment ids. Addresses are
	# cut short (the last part of an IPv4 address becomes 0), as the privacy page says. Check a change with
	# `sudo -u caddy caddy validate ...`: a validate run as root creates the log file owned by root, and the running Caddy
	# then fails to reload with "permission denied" (switched on this way on 2026-11-10).
	log {
		output file /var/log/caddy/memestreet-access.log {
			roll_size 20MiB
			roll_keep_for 720h
			mode 0640                    # readable by the caddy group, which the game's user joins (the admin page's numbers)
		}
		format filter {
			wrap json
			fields {
				request>headers>X-Token delete
				request>headers>X-Visitor delete
				request>headers>X-Admin-Key delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				request>headers>Cf-Connecting-Ip delete
				request>headers>X-Forwarded-For delete
				request>uri query {
					delete token
					delete t
					delete order
					delete session_id
					delete key
					delete code
				}
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				resp_headers delete
			}
		}
	}

	# --- Optional: put the admin page behind a second password. The admin key alone has no limit on wrong guesses
	# (ROADMAP A10), so this is worth doing before real players arrive. Make a password hash with
	#     caddy hash-password
	# then remove the leading # from the block below and paste the hash. Your browser will ask for the name and
	# password once, then the admin page asks for the admin key as usual.
	#
	# @admin path /admin /admin/* /api/admin/*
	# basic_auth @admin {
	#	owner PASTE_THE_HASH_HERE
	# }

	# the daily reel, for Instagram to fetch (tools/memestreet_daily_reel; 3 days kept)
	handle_path /reels/* {
		root * /var/www/memestreet-reels
		file_server
	}

	reverse_proxy 127.0.0.1:8000 {
		# The gateway trusts these two headers (it needs the visitor's real address for the sign-up and login limits),
		# so a visitor must never be able to send his own. Caddy sets X-Forwarded-For itself (the visitor's address, see
		# trusted_proxies at the top); this removes the other.
		header_up -CF-Connecting-IP
		header_up X-Forwarded-For {client_ip}
	}
}

www.YOURDOMAIN {
	redir https://YOURDOMAIN{uri} permanent
}
