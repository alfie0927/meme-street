# Settings for the server, kept in /etc/memestreet.env (readable only by root and the game). setup_server.sh creates this
# file with random keys the first time; edit it with:  nano /etc/memestreet.env
# After any change:  systemctl restart memestreet memestreet-gateway

# The key for the /admin page. Long and secret.
ADMIN_KEY=change-me-to-a-long-random-string

# The secret the gateways use to talk to the game server. Long and secret.
CORE_KEY=change-me-too
CORE_URL=ws://127.0.0.1:8001/internal/gateway

# How many gateway processes (one per processor core is a good number; 2 for a small server).
GATEWAYS=2

# Mail (verification codes and password recovery). Without SMTP_HOST nothing is sent: the codes only show on the admin
# page. Any SMTP service works (Resend, Brevo, Postmark, Amazon SES...); it gives you these values.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=your-api-key
# MAIL_FROM=Meme Street <no-reply@yourdomain.com>
